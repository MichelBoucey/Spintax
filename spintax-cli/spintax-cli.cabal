name:          spintax-cli
version:       0.1.0.0
synopsis:      CLI tool for spintax random text generation
description:
  Command-line interface for generating random text from spintax templates.

license:       BSD3
license-file:  LICENSE
author:        Michel Boucey
maintainer:    michel.boucey@gmail.com
copyright:     (c) 2016-2025 - Michel Boucey
category:      Text, CLI
build-type:    Simple
cabal-version: >=1.10
tested-with:
  GHC ==8.8.4
   || ==8.10.7
   || ==9.0.2
   || ==9.2.8
   || ==9.4.8
   || ==9.6.7
   || ==9.8.4
   || ==9.10.2
   || ==9.12.2
   || ==9.14.1

executable spintax
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:
    Options
    Paths_spintax_cli

  default-language: Haskell2010
  ghc-options:      -Wall -O2
  build-depends:
      base                  >=4.7  && <5
    , optparse-applicative  >=0.14 && <1
    , Spintax
    , text                  >=1.1  && <2.2
